# Backend environment (docs/ENVIRONMENT.md §1). Copy to backend/.env and fill in.
# backend/.env is git-ignored; never commit real values. All values here are private.
APP_ENV=development
# Supabase → Connect → Session pooler URI, with your database password filled in
DATABASE_URL=
# Same, for the separate empty "alovia-test" project; used only by the migration tests
TEST_DATABASE_URL=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_…), backend only
SUPABASE_SERVICE_ROLE_KEY=
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
# Start of invite links (not secret); the deployed patient app URL in Phase 9
PATIENT_APP_URL=http://localhost:5173
# Development seed only (scripts/seed_dev.py): the seven test logins' passwords. Never commit.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_DOCTOR=
SEED_PASSWORD_PATIENT1=
SEED_PASSWORD_PATIENT2=
SEED_PASSWORD_PATIENT3=
SEED_PASSWORD_PATIENT4=
SEED_PASSWORD_PATIENT5=
